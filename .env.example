# URL da aplicação (usada em sitemap, metadata, links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta do NextAuth (use `openssl rand -base64 32` para gerar)
AUTH_SECRET=

# URL base usada pelo NextAuth para redirecionamentos
AUTH_URL=http://localhost:3000

# Banco de dados SQLite (não mude sem ajustar schema.prisma)
DATABASE_URL="file:./dev.db"

# OAuth - Google (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Dono da loja (recebe acesso admin automaticamente)
OWNER_EMAIL=
NEXT_PUBLIC_OWNER_EMAIL=

# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# PayPal (https://developer.paypal.com/dashboard/)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# PIX
PIX_KEY=
PIX_NAME=
PIX_CITY=
PIX_EXPIRATION_HOURS=24

# E-mail (SMTP)
# Para Gmail: ative 2FA e gere uma "Senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Discord - bot e integrações
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_ORDERS_WEBHOOK_URL=

# Discord - bot (comandos slash)
# ID do cliente do bot (mesmo Application ID do Discord Developer Portal)
# Pode ser o mesmo DISCORD_CLIENT_ID se for a mesma aplicação
# ID do cargo de admin da loja no Discord (opcional — se vazio, usa permissão Administrator)
DISCORD_ADMIN_ROLE_ID=
# ID do cargo de suporte no Discord (opcional — staff de tickets)
DISCORD_SUPPORT_ROLE_ID=
# ID do cargo de dono da loja no Discord (opcional — para comandos /aprovar e /rejeitar)
DISCORD_OWNER_ROLE_ID=
# ID da categoria onde canais de ticket serão criados (opcional)
DISCORD_TICKET_CATEGORY_ID=

# API do ShopPix para o bot (gere a chave em /admin/apigenerator)
# URL base do site (sem barra no final)
SHOPIX_API_URL=https://shop-pix.com
# Chave de API gerada no painel admin → Gerador de API
SHOPIX_API_KEY=

# Chave para criptografar credenciais digitais no banco (use 32 bytes hex)
CREDENTIALS_ENCRYPTION_KEY=
